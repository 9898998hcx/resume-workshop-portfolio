# FastAPI foundation settings. Copy to backend/.env for local use.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ORIGIN=http://127.0.0.1:3000
LOG_LEVEL=INFO

# Development default. Production must use a MySQL URL instead.
DATABASE_URL=sqlite+pysqlite:///./data/resume_workshop.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Mock providers are intentional in phase 1.
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_SECONDS=30

# Optional read-only GitHub token for the template collector. It improves the
# GitHub API rate limit; never commit the real token.
GITHUB_TOKEN=

SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

CAPTCHA_PROVIDER=mock
TURNSTILE_SECRET_KEY=

# Reserved for later authentication and deployment phases.
APP_SECRET_KEY=
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_OTP=1/minute
RATE_LIMIT_AI=10/minute
